generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String                @id @default(uuid())
  username     String                @unique
  passwordHash String
  role         String                @default("USER")
  status       String                @default("APPROVED")
  apiKeys      String?
  // Profile identity used to set the Jira "reporter" when an integration opts in.
  email        String                @default("") // maps to a Jira user by email (DC user search)
  jiraUsername String                @default("") // optional explicit Jira username override (DC)
  tokenVersion Int                   @default(0)
  createdAt    DateTime              @default(now())
  scans        Scan[]
  settings     UserSettings?
  customModels CustomModel[]
  projects     Project[]
  instructions Instruction[]
  ownedJira    JiraIntegration[]     @relation("OwnedJira")
  jiraOptIns   UserJiraIntegration[]
  resetRequests PasswordResetRequest[]
  technologies Technology[]
}

// A locked-out user's request for an admin to reset their password. The user
// can't log in, so they submit this from the login page; an admin sees it on the
// User Access Control page and sets a new password, which resolves the request.
model PasswordResetRequest {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     String    @default("PENDING") // PENDING | RESOLVED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String? // username of the admin who reset the password

  @@index([userId, status])
}

model Instruction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Scan {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  target          String
  projectName     String          @default("")
  llmModel        String          @default("openai/gpt-4o")
  scanMode        String          @default("standard")
  status          String          @default("scheduled")
  startedAt       DateTime        @default(now())
  period          String          @default("none")
  nextRunAt       DateTime?
  vulnCount       Int             @default(0)
  payload         Json?
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vulnerabilities Vulnerability[]
  // Distinguishes automated scan types. "standard" = a normal user/scheduled
  // scan; "cve_lookup" = a lightweight ASM version-recheck + CVE-search run;
  // "cve_scan" = a full verification scan auto-spawned when the lookup found a
  // CVE (it auto-loads the instruction titled "cve_scan").
  kind            String          @default("standard")
  // For kind="cve_lookup"/"cve_scan": the Technology asset this scan targets.
  techId          String?
  technology      Technology?     @relation("TechScans", fields: [techId], references: [id], onDelete: SetNull)
}

model UserSettings {
  id                 String @id @default(uuid())
  userId             String @unique
  user               User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  aggressiveness     Int    @default(50)
  maxThreads         Int    @default(4)
  theme              String @default("dark")
  defaultModel       String @default("openai/gpt-4o")
  autoDeleteDays     Int    @default(0)
  jiraBaseUrl        String @default("")
  jiraPat            String @default("") // AES-encrypted at rest
  jiraProjectId      String @default("")
  jiraIssueTypeId    String @default("")
  // Providers for which this user opted into the admin-shared API key.
  // JSON array of provider names, e.g. ["deepseek","openai"].
  sharedKeyProviders String @default("")
}

// A single Jira integration/config. Two deployment flavors:
//   DATACENTER — REST v2, Bearer PAT, wiki-markup descriptions (e.g. Kapitalbank)
//   CLOUD      — REST v3, Basic email:token, ADF descriptions (e.g. Bir Ecosystem)
model JiraIntegration {
  id          String                @id @default(uuid())
  name        String
  deployment  String                @default("DATACENTER") // "DATACENTER" | "CLOUD"
  baseUrl     String
  authEmail   String                @default("") // CLOUD basic-auth email; empty for DATACENTER
  authSecret  String                @default("") // AES-encrypted: DC PAT or Cloud API token
  projectId   String                @default("")
  issueTypeId String                @default("")
  // Field metadata for the report modal (company field id + options, priority,
  // security-level field for DC, participants field id, etc.). Shape is
  // deployment-specific; see src/lib/jira/*.
  config      Json?
  shared      Boolean               @default(false) // superadmin "streamed" it to everyone
  ownerId     String? // null = shared preset; else the creator
  owner       User?                 @relation("OwnedJira", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt   DateTime              @default(now())
  optIns      UserJiraIntegration[]
}

// A user has accepted/enabled an integration, with their per-integration defaults.
model UserJiraIntegration {
  id              String          @id @default(uuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  integrationId   String
  integration     JiraIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  defaultAssignee String          @default("") // accountId (CLOUD) or username (DATACENTER)
  defaultCompany  String          @default("") // customfield option id (CLOUD)
  createdAt       DateTime        @default(now())

  @@unique([userId, integrationId])
}

// Singleton row (id = "singleton") for superadmin-managed global settings.
model AppSettings {
  id                String  @id @default("singleton")
  sharedApiKeys     String  @default("") // AES-encrypted blob, same shape as User.apiKeys
  sharedKeysEnabled Boolean @default(false) // shared keys accessible to everyone
  // ASM / CVE-lookup automation. When enabled, the scheduler daemon periodically
  // re-verifies each tracked Technology's live version and searches for CVEs.
  cveLookupEnabled      Boolean @default(false)
  cveLookupIntervalHours Int    @default(24)
  // Model used by automatic CVE-lookup runs (must have an API key configured).
  cveLookupModel        String  @default("openai/gpt-4o")
}

// Attack Surface Management (ASM) inventory: a third-party / vendor solution
// (web server, CMS, framework, library, WAF, …) detected on a target during a
// scan, with the version we currently believe is running. The recurring CVE
// lookup re-verifies the version (updating it in place) and searches published
// advisories for that exact version; a hit auto-spawns a "cve_scan".
model Technology {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  target           String // host/URL where the solution was detected
  vendor           String    @default("") // e.g. "Atlassian", "nginx", "WordPress"
  product          String // e.g. "Confluence", "nginx", "jQuery"
  version          String    @default("") // best-known running version
  ecosystem        String    @default("") // npm/pypi/maven/os/webserver/cms/…
  category         String    @default("") // "web server" | "CMS" | "framework" | "library" | …
  description      String    @default("")
  evidence         String    @default("") // how it was fingerprinted
  firstScanId      String? // scan that first detected it
  // CVE-lookup lifecycle.
  cveStatus        String    @default("unknown") // unknown | clean | vulnerable | checking
  foundCves        Json? // [{ cve, cvss, severity, summary, fixedVersion }]
  versionCheckedAt DateTime? // last time the live version was re-verified
  cveCheckedAt     DateTime? // last completed CVE lookup
  nextCveCheckAt   DateTime? // scheduler picks rows due at/after this
  lastSeenAt       DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  scans            Scan[]    @relation("TechScans")

  @@unique([userId, target, vendor, product])
  @@index([nextCveCheckAt])
}

model CustomModel {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  value  String
  label  String
}

model Project {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  scans     Scan[]
}

model Vulnerability {
  id          String   @id @default(uuid())
  scanId      String
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  vulnId      String
  title       String
  severity    String
  target      String?
  endpoint    String?
  method      String?
  description String
  poc         String?
  cvss        Float?
  remediation String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}
