generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  role         String   @default("USER")
  apiKeys      String?
  createdAt    DateTime @default(now())
  scans        Scan[]
  settings     UserSettings?
  customModels CustomModel[]
  projects     Project[]
}

model Scan {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  target       String
  projectName  String    @default("")
  llmModel     String    @default("openai/gpt-4o")
  scanMode     String    @default("standard")
  status       String    @default("scheduled")
  startedAt    DateTime  @default(now())
  period       String    @default("none")
  nextRunAt    DateTime?
  vulnCount    Int       @default(0)
  payload      Json?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  vulnerabilities Vulnerability[]
}

model UserSettings {
  id                 String  @id @default(uuid())
  userId             String  @unique
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  aggressiveness     Int     @default(50)
  maxThreads         Int     @default(4)
  webhookUrl         String  @default("")
  notifyOnStart      Boolean @default(false)
  notifyOnFinish     Boolean @default(true)
}

model CustomModel {
  id          String @id @default(uuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  value       String
  label       String
}

model Project {
  id          String   @id @default(uuid())
  name        String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  scans       Scan[]
}

model Vulnerability {
  id          String   @id @default(uuid())
  scanId      String
  scan        Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)
  vulnId      String
  title       String
  severity    String
  endpoint    String?
  method      String?
  description String
  poc         String?
  cvss        Float?
  remediation String?
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
}
